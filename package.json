{
  "name": "m8",
  "version": "0.0.0",
  "private": true,
  "description": "A character that lives in a browser tab as a pair of expressive eyes.",
  "author": "Josep Boix Requesens",
  "license": "MIT",
  "homepage": "https://github.com/jboix/m8#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jboix/m8.git"
  },
  "bugs": {
    "url": "https://github.com/jboix/m8/issues"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter './apps/*' dev",
    "build": "bun run --filter './apps/*' build",
    "start": "NODE_ENV=production bun apps/server/src/index.ts",
    "pack": "bun scripts/pack.ts",
    "check": "bun run lint && bun run docs:check && bun run arch && bun run knip && bun run typecheck && bun run test",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "docs:check": "remark . --quiet --frail --use ./scripts/remark-check-formatted.mjs",
    "docs:format": "remark . --quiet --output",
    "arch": "depcruise apps/*/src packages/*/src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/salience && tsc --noEmit -p packages/persona && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@types/bun": "1.4.2",
    "dependency-cruiser": "18.3.1",
    "husky": "9.1.7",
    "knip": "6.37.0",
    "remark-cli": "12.0.1",
    "remark-gfm": "4.0.1",
    "remark-validate-links": "13.1.0",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3"
  }
}
